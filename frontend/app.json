{
  "expo": {
    "name": "Gunluk Ayet",
    "slug": "gunluk-ayet",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gunluk-ayet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Duvar kagidi gorseli kaydetmek icin",
        "NSPhotoLibraryAddUsageDescription": "Duvar kagidini galeriye kaydetmek icin"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.gunlukayet.app",
      "versionCode": 135
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Duvar kagidini galeriye kaydetmek icin izin gerekli.",
          "savePhotosPermission": "Duvar kagidini kaydetmek icin izin gerekli."
        }
      ]
    ]
  }
}
